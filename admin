<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LogoBoss AI · Admin V1</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:#eaf0ff;background:#080c1c}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0%,#142455 0%,#080c1c 45%);min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer}.layout{display:grid;grid-template-columns:245px minmax(0,1fr);min-height:100vh}aside{padding:26px 17px;background:#0b1025;border-right:1px solid #293352}.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:21px;margin-bottom:42px}.brand i{display:grid;place-items:center;width:37px;height:37px;border-radius:11px;background:linear-gradient(130deg,#22ccf6,#5342ff);font-style:normal}nav button{display:block;width:100%;text-align:left;border:0;border-radius:12px;color:#aebce0;background:transparent;padding:14px;margin:4px 0}nav button.active,nav button:hover{color:white;background:#1b2850}main{padding:32px;max-width:1600px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.sub{color:#a4b3d6}.pill{padding:7px 11px;border-radius:20px;background:#182348;border:1px solid #344573;color:#a8c6ff;font-size:12px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:26px 0}.card,.panel{background:#10182f;border:1px solid #29395c;border-radius:18px;padding:20px}.card b{font-size:28px;display:block;margin-top:10px}.panel{margin-top:20px;overflow:auto}h1{font-size:30px;letter-spacing:-1px;margin:0}h2{font-size:19px;margin:0 0 16px}.muted{color:#a3b2d5;font-size:13px}table{border-collapse:collapse;width:100%;min-width:750px}th,td{text-align:left;padding:13px;border-bottom:1px solid #283653;font-size:13px}th{color:#a9b9dc}input,select,textarea{background:#0b1228;border:1px solid #405076;border-radius:10px;padding:11px;color:white;width:100%}button.primary{border:0;background:linear-gradient(100deg,#18b9e9,#5c50f2);color:white;padding:12px 17px;border-radius:11px;font-weight:700}button.ghost{background:#182448;border:1px solid #3b4a74;color:white;padding:10px 14px;border-radius:10px}.tools{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:15px}.tools input{max-width:300px}.tools select{max-width:190px}.tag{border:1px solid #3d5480;border-radius:99px;padding:5px 9px;display:inline-block;color:#b8d2ff}.hidden{display:none!important}.fields{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.fields label{font-size:12px;color:#a8b7d8}.fields label input,.fields label textarea,.fields label select{margin-top:6px}.wide{grid-column:1/-1}.note{background:#18223d;border-left:3px solid #64aaff;padding:14px;border-radius:8px;margin:20px 0}.right{margin-left:auto}.error{color:#ffb1b1}.ok{color:#85e8b9}a{color:#9adfff}@media(max-width:950px){.grid{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid #293352;padding:16px}nav{display:flex;overflow:auto}nav button{white-space:nowrap;width:auto}.brand{margin-bottom:10px}main{padding:19px}}@media(max-width:530px){.grid,.fields{grid-template-columns:1fr}h1{font-size:24px}}
</style></head><body><div class="layout"><aside><div class="brand"><i>◈</i>LogoBoss AI</div><div class="pill" style="display:inline-block;margin-bottom:18px">ADMIN · PRIVATE TEST</div><nav id="nav"><button class="active" data-view="overview">◫ Übersicht</button><button data-view="orders">▤ Anfragen</button><button data-view="clients">♙ Kunden</button><button data-view="packages">▦ 13 Pakete</button><button data-view="settings">⚙ Einstellungen</button></nav></aside><main><div class="top"><div><h1 id="title">Übersicht</h1><div class="sub">LogoBoss AI · interne Vorbereitung</div></div><div style="display:flex;gap:8px;align-items:center"><span class="pill" id="mode">DEMO · Nur Beispieldaten</span><button class="ghost hidden" id="logout">Abmelden</button></div></div><div class="note" id="banner">Keine echten Bestellungen oder Zahlungen. Die Daten in der Demo sind frei erfunden. Stripe Live ist nicht verbunden.</div>
<section id="login" class="panel"><h2>Supabase-Verbindung (optional)</h2><p class="muted">Ohne Anmeldung kannst du das Dashboard mit Beispieldaten prüfen. Für echte Daten muss die separate Datenbank mit RLS vorbereitet sein. Verwende ausschließlich den öffentlichen anon/publishable key, niemals den service_role key.</p><div class="fields"><label>Supabase Projekt-URL<input id="url" placeholder="https://projekt.supabase.co" autocomplete="off"></label><label>Publishable / anon key<input id="key" placeholder="sb_publishable_…" type="password" autocomplete="off"></label><label>E-Mail<input id="email" type="email" autocomplete="username"></label><label>Passwort<input id="password" type="password" autocomplete="current-password"></label></div><div class="tools" style="margin-top:14px"><button class="primary" id="loginBtn">Sicher anmelden</button><span class="muted" id="loginMsg"></span></div></section>
<section id="overview"><div class="grid"><div class="card"><span class="muted">Anfragen gesamt</span><b id="total">0</b></div><div class="card"><span class="muted">Neue Anfragen</span><b id="new">0</b></div><div class="card"><span class="muted">Kunden</span><b id="clientCount">0</b></div><div class="card"><span class="muted">Pakete</span><b>13</b></div></div><div class="panel"><h2>Letzte Anfragen</h2><div id="recent"></div></div></section>
<section id="orders" class="hidden"><div class="panel"><div class="tools"><input id="search" placeholder="Name, Firma oder E-Mail suchen"><select id="filter"><option value="">Alle Status</option><option value="new">Neu</option><option value="reviewing">In Prüfung</option><option value="contacted">Kontaktiert</option><option value="closed">Abgeschlossen</option></select><button class="ghost right" id="export">CSV exportieren</button></div><div id="orderTable"></div></div><div class="panel hidden" id="editor"><h2>Anfrage bearbeiten</h2><div class="fields"><label>Status<select id="editStatus"><option value="new">Neu</option><option value="reviewing">In Prüfung</option><option value="contacted">Kontaktiert</option><option value="closed">Abgeschlossen</option></select></label><label>Notiz<textarea id="editNote" rows="3" maxlength="2000"></textarea></label></div><div class="tools" style="margin-top:12px"><button class="primary" id="save">Speichern</button><button class="ghost" id="cancel">Schließen</button><span id="saveMsg" class="muted"></span></div></div></section>
<section id="clients" class="hidden"><div class="panel"><h2>Kunden / Kontakte</h2><div id="clientTable"></div></div></section>
<section id="packages" class="hidden"><div class="panel"><h2>Aktuelle Paketpreise · netto</h2><p class="muted">Interner Preisplan; kein öffentliches Verkaufsangebot. Zusatzleistungen und AI-Verbrauch nach Vereinbarung.</p><div id="packageTable"></div></div></section>
<section id="settings" class="hidden"><div class="panel"><h2>Systemstatus</h2><p id="connection">Demo-Modus: keine Datenbank verbunden.</p><p class="muted">Die öffentliche Website bleibt unverändert. Der vorhandene submit-order-Endpunkt ist noch NICHT an dieses Admin-Schema angeschlossen. Vor einer Freigabe: Schema und Edge Function sicher integrieren, E-Mail testen, Backups und Datenschutz prüfen.</p><p><strong>Rechtlicher Status:</strong> Nur interne Vorbereitung; keine kommerzielle Tätigkeit bis zur erforderlichen Erlaubnis.</p></div></section></main></div>
<script type="module">
const $=id=>document.getElementById(id), escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const packages=[['Web Studio','Digital Start',1190,59],['Web Studio','Web Business',2320,99],['Web Studio','Web Pro',3920,149],['AI Assistants','Business AI',790,79],['AI Assistants','Pro AI',2320,149],['AI Assistants','AI Custom',3920,299],['Automation Studio','Automation Start',720,49],['Automation Studio','Automation Business',2000,149],['Automation Studio','Automation Pro',5520,299],['Company OS','Company OS Start',3990,199],['Company OS','Company OS Business',8990,499],['Company OS','Company OS Pro',19990,999],['Company OS','Company OS Enterprise',39990,1999]];
const demo=[{id:'demo-1',customer_name:'Anna Beispiel',company_name:'Beispiel Salon',email:'anna@example.invalid',package_name:'Business AI',status:'new',admin_note:'Nur Demo',created_at:'2026-10-08T10:00:00Z'},{id:'demo-2',customer_name:'Max Muster',company_name:'Muster Werkstatt',email:'max@example.invalid',package_name:'Web Business',status:'reviewing',admin_note:'Nur Demo',created_at:'2026-10-07T12:00:00Z'}];
let rows=demo.slice(),sb=null,selected=null,view='overview',live=false;const money=n=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n);const dt=x=>new Date(x).toLocaleDateString('de-DE');
function table(items,cols){return '<table><thead><tr>'+cols.map(c=>'<th>'+c[0]+'</th>').join('')+'</tr></thead><tbody>'+items.map(r=>'<tr>'+cols.map(c=>'<td>'+c[1](r)+'</td>').join('')+'</tr>').join('')+'</tbody></table>'}
function render(){ $('total').textContent=rows.length;$('new').textContent=rows.filter(x=>x.status==='new').length;$('clientCount').textContent=new Set(rows.map(x=>x.email.toLowerCase())).size;
const orderCols=[['Datum',r=>escapeHTML(dt(r.created_at))],['Kontakt',r=>escapeHTML(r.customer_name)],['Firma',r=>escapeHTML(r.company_name)],['Paket',r=>escapeHTML(r.package_name)],['Status',r=>'<span class="tag">'+escapeHTML(r.status)+'</span>']];
$('recent').innerHTML=table(rows.slice(0,5),orderCols);
let q=$('search').value.toLowerCase(),f=$('filter').value;let filtered=rows.filter(r=>(!f||r.status===f)&&[r.customer_name,r.company_name,r.email,r.package_name].join(' ').toLowerCase().includes(q));$('orderTable').innerHTML=table(filtered,[...orderCols,['Aktion',r=>'<button class="ghost" data-edit="'+escapeHTML(r.id)+'">Öffnen</button>']]);
$('clientTable').innerHTML=table([...new Map(rows.map(r=>[r.email.toLowerCase(),r])).values()],[['Name',r=>escapeHTML(r.customer_name)],['Firma',r=>escapeHTML(r.company_name)],['E-Mail',r=>escapeHTML(r.email)]]);
$('packageTable').innerHTML=table(packages,[['Bereich',r=>escapeHTML(r[0])],['Paket',r=>escapeHTML(r[1])],['Setup',r=>money(r[2])],['Monatlich',r=>money(r[3])]]);
}
function show(v){view=v;for(const s of ['overview','orders','clients','packages','settings'])$(s).classList.toggle('hidden',s!==v);$('title').textContent=({overview:'Übersicht',orders:'Anfragen',clients:'Kunden',packages:'Pakete',settings:'Einstellungen'})[v];document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===v));}
$('nav').addEventListener('click',e=>{let b=e.target.closest('button[data-view]');if(b)show(b.dataset.view)});$('search').addEventListener('input',render);$('filter').addEventListener('change',render);
$('orderTable').addEventListener('click',e=>{const b=e.target.closest('[data-edit]');if(!b)return;selected=rows.find(x=>x.id===b.dataset.edit);if(!selected)return;$('editStatus').value=selected.status;$('editNote').value=selected.admin_note||'';$('editor').classList.remove('hidden');$('saveMsg').textContent='';});$('cancel').onclick=()=>$('editor').classList.add('hidden');
$('save').onclick=async()=>{if(!selected)return;const status=$('editStatus').value,admin_note=$('editNote').value;$('saveMsg').textContent='Speichern…';if(live){const {error}=await sb.from('lb_admin_orders').update({status,admin_note}).eq('id',selected.id);if(error){$('saveMsg').textContent=error.message;return}}selected.status=status;selected.admin_note=admin_note;$('saveMsg').textContent='Gespeichert';render()};
$('export').onclick=()=>{const data=[['Datum','Name','Firma','Email','Paket','Status'],...rows.map(r=>[r.created_at,r.customer_name,r.company_name,r.email,r.package_name,r.status])];const csv='\uFEFF'+data.map(row=>row.map(x=>'"'+String(x??'').replaceAll('"','""')+'"').join(';')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='logoboss-anfragen-'+new Date().toISOString().slice(0,10)+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
$('loginBtn').onclick=async()=>{const url=$('url').value.trim(),key=$('key').value.trim();if(!/^https:\/\/[a-z0-9-]+\.supabase\.co\/?$/.test(url)||!key){$('loginMsg').textContent='Gültige Supabase-URL und anon key erforderlich';return}try{const {createClient}=await import('https://esm.sh/@supabase/supabase-js@2');sb=createClient(url,key,{auth:{persistSession:false,autoRefreshToken:false}});const {error}=await sb.auth.signInWithPassword({email:$('email').value,password:$('password').value});if(error)throw error;const result=await sb.from('lb_admin_orders').select('id,customer_name,company_name,email,package_name,status,admin_note,created_at').order('created_at',{ascending:false}).limit(500);if(result.error)throw result.error;rows=result.data||[];live=true;$('login').classList.add('hidden');$('logout').classList.remove('hidden');$('mode').textContent='SUPABASE · ADMIN';$('banner').textContent='Interner Testmodus. Keine echten Zahlungen oder kommerziellen Aufträge freigeben.';$('connection').textContent='Supabase verbunden. Die Website-Order-Function ist nicht automatisch integriert.';render()}catch(e){$('loginMsg').textContent='Verbindung fehlgeschlagen: '+e.message;live=false;sb=null}};
$('logout').onclick=async()=>{if(sb)await sb.auth.signOut();sb=null;live=false;rows=demo.slice();$('login').classList.remove('hidden');$('logout').classList.add('hidden');$('mode').textContent='DEMO · Nur Beispieldaten';$('banner').textContent='Keine echten Bestellungen oder Zahlungen. Die Daten in der Demo sind frei erfunden.';render()};render();
</script></body></html>
